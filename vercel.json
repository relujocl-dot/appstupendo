{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/pages/agenda",
      "destination": "/agenda/"
    },
    {
      "source": "/pages/finanzas",
      "destination": "/finanzas/"
    }
  ]
}
